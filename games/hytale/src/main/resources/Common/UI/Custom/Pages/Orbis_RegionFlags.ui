$C = "../Common.ui";

@OrbisGold = #93844c;

@RegionNameStyle = LabelStyle(
  FontSize: 18,
  RenderBold: true,
  TextColor: @OrbisGold
);

@CaptionStyle = LabelStyle(
  FontSize: 14,
  TextColor: #ffffff(0.8)
);

@BackButtonStyle = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 14, TextColor: @OrbisGold, RenderBold: true)),
  Sounds: $C.@ButtonSounds
);

$C.@PageOverlay {
  $C.@DecoratedContainer {
    @CloseButton = true;

    Anchor: (Width: 650, Height: 669);

    #Title {
      TextButton #BackButton {
        Anchor: (Left: 12, Top: 4, Width: 64, Height: 24);
        Padding: (Left: 8, Top: 2);
        Text: %ui.orbis.common.back;
        Style: @BackButtonStyle;
        Background: #000000(0.13);
      }

      Group {
        $C.@Title #TitleText {
          @Text = %ui.orbis.region.flags.title;
        }
      }
    }

    #Content {
      LayoutMode: Left;

      Group #Main {
        LayoutMode: Top;

        Group {
          LayoutMode: Left;
          Anchor: (Bottom: 10);

          Label #RegionNameLabel {
            FlexWeight: 1;
            Anchor: (Left: 4, Vertical: 0);
            Style: @RegionNameStyle;
          }

          Label #FlagCountLabel {
            Anchor: (Right: 8, Vertical: 0);
            Style: @CaptionStyle;
          }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Bottom: 12);

          $C.@DropdownBox #FlagSelector {
            FlexWeight: 1;
            Anchor: (Height: 30);
            // @DefaultDropdownBoxStyle already carries a SearchInputStyle; this just enables it.
            ShowSearchInput: true;
          }

          $C.@TextButton #AddFlagButton {
            Anchor: (Width: 196, Height: 30, Left: 8);
            Text: %ui.orbis.region.flags.add;
          }
        }

        Group #FlagList {
          Anchor: (Width: 630);
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Left: 4, Right: 4);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;

          Group #FlagCards {
            LayoutMode: Top;
          }
        }
      }
    }
  }
}

$C.@BackButton {}
