$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Bottom: 6);

  $C.@DropdownBox #ParentSelector {
    FlexWeight: 1;
    Anchor: (Height: 28, Right: 8);
    // @DefaultDropdownBoxStyle already carries a SearchInputStyle; this just enables it.
    ShowSearchInput: true;
  }

  $C.@TextButton #AddParent {
    Anchor: (Width: 192, Height: 28);
    Text: %ui.orbis.region.info.addParent;
  }
}
