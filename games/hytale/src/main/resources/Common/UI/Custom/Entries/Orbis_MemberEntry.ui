$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 34, Bottom: 5);
  Padding: (Top: 4, Bottom: 4);
  Background: $C.@InputBoxBackground;

  TextTooltipShowDelay: 0.1;
  TextTooltipStyle: $C.@DefaultTextTooltipStyle;

  Label #MemberName {
    Style: (
      FontSize: 15,
      RenderBold: true,
      TextColor: #ffffff
    );
    Anchor: (Left: 10, Vertical: 0);
    Padding: (Right: 5);
  }

  Label #MemberType {
    Padding: (Left: 6, Right: 6, Top: 2, Bottom: 2);
    Style: (
      FontSize: 13,
      TextColor: #ffffff
    );
    Anchor: (Left: 4, Vertical: 0);
    Background: (Color: #ec8a1a83);
    OutlineColor: #ec8a1ade;
    OutlineSize: 1.5;
    ContentHeight: 10;
  }

  Label { FlexWeight: 1; }

  $C.@CancelTextButton #RemoveMember {
    Anchor: (Width: 160, Height: 26, Right: 8, Vertical: 0);
    Text: %ui.orbis.common.remove;
    Overscroll: false;
  }
}
