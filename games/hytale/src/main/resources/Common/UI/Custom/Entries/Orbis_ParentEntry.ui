$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 34, Bottom: 5);
  Padding: (Top: 4, Bottom: 4);
  Background: $C.@InputBoxBackground;

  TextTooltipShowDelay: 0.1;
  TextTooltipStyle: $C.@DefaultTextTooltipStyle;

  Label #ParentName {
    Style: (
      FontSize: 15,
      RenderBold: true,
      TextColor: #ffffff
    );
    Anchor: (Left: 10, Vertical: 0);
  }

  Label { FlexWeight: 1; }

  $C.@CancelTextButton #RemoveParent {
    Anchor: (Width: 160, Height: 26, Right: 8, Vertical: 0);
    Text: %ui.orbis.common.remove;
    Overscroll: false;
  }
}
